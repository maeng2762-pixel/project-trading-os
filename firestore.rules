rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth Check
    function isAuthenticated() {
      return request.auth != null;
    }

    // Role-based Access Control (RBAC)
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Tenant Isolation (Only owner can access)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validation Functions
    function isValidString(text, min, max) {
      return text is string && text.size() >= min && text.size() <= max;
    }

    function isValidNumber(num, min, max) {
      return num is number && num >= min && num <= max;
    }

    // --- Users Collection ---
    match /users/{userId} {
      // User can read/write their own data. Admin can read all.
      allow read: if isOwner(userId) || isAdmin();
      
      // Strict Validation for Creation (Least Privilege & Schema)
      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(['email', 'displayName', 'createdAt', 'tier', 'settings'])
                    && isValidString(request.resource.data.email, 5, 255)
                    && request.resource.data.tier in ['FREE', 'PRO']
                    && request.resource.data.createdAt == request.time;
                    
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt', 'email']) // Prevent changing immutable fields
                    && (request.resource.data.tier == resource.data.tier || isAdmin()); // Only admin can forcefully change tier, or self via specific backend flow
    }

    // --- Audit Logs (Append Only) ---
    match /audit_logs/{logId} {
      allow read: if isAdmin(); // Only admins can read audit logs
      
      // Anyone authenticated can append their own log, but cannot modify or delete
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['action', 'userId', 'timestamp'])
                    && request.resource.data.timestamp == request.time;
                    
      allow update, delete: if false; // Immutable audit trail
    }

    // --- Trades / Portfolios (Tenant Isolated) ---
    match /users/{userId}/trades/{tradeId} {
      allow read, write: if isOwner(userId);
    }
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
